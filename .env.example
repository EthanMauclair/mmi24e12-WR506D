# Copier ce fichier en .env (non versionné) puis adapter les valeurs.
#   cp .env.example .env
#
# Utiliser uniquement des lettres et des chiffres dans les mots de passe :
# ils sont insérés tels quels dans l'URL de connexion DATABASE_URL.

MARIADB_DATABASE=penderie
MARIADB_USER=penderie
MARIADB_PASSWORD=changeMe
MARIADB_ROOT_PASSWORD=changeMeToo
