# Copier ce fichier en .env (non versionné) puis adapter les valeurs.
#   cp .env.example .env

# Base de données MariaDB
MARIADB_VERSION=13.0
MARIADB_SERVER_VERSION=13.0.2-MariaDB
MARIADB_DATABASE=penderie
MARIADB_USER=penderie
MARIADB_PASSWORD=change_me
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_PORT=3306

# Symfony : générer une valeur aléatoire (ex. openssl rand -hex 32)
APP_SECRET=change_me

# Ports exposés sur la machine hôte
API_PORT=8080
FRONTEND_PORT=5173

# Reconnaissance des vêtements par IA (OpenRouter) : clé gratuite sur https://openrouter.ai/keys
# Sans clé, le scan garde la photo et les champs se remplissent à la main.
OPENROUTER_API_KEY=
OPENROUTER_MODELE=google/gemma-4-31b-it:free
