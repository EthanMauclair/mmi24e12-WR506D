                  "if (logement.pieces.length) { pm.collectionVariables.set('pieceId', logement.pieces[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechercher un article",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logements/{{logementId}}/recherche?q=levi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logements",
                "{{logementId}}",
                "recherche"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "levi"
                }
              ]
            },
            "description": "Recherche par titre, catégorie, marque ou couleur (2 caractères minimum). Chaque résultat indique son emplacement."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
