              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Créée (201) ou déjà existante (422)', () => pm.expect(pm.response.code).to.be.oneOf([201, 422]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Détail d'une pièce",
