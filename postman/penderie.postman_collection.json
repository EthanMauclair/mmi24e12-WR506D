{
  "info": {
    "name": "Penderie API",
    "description": "Collection Postman de l'API de la penderie.\n\nL'authentification se fait par cookie de session : lancez d'abord « Connexion », Postman renvoie ensuite le cookie automatiquement.\n\nLes requêtes d'inventaire utilisent les variables logementId, pieceId et articleId, remplies par les tests des requêtes précédentes. Avec les données de démonstration (doctrine:fixtures:load), le compte lea@exemple.fr / penderie2026 est propriétaire du logement « Appartement Lyon ».",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "lea@exemple.fr"
    },
    {
      "key": "motDePasse",
      "value": "penderie2026"
    },
    {
      "key": "logementId",
      "value": ""
    },
    {
      "key": "pieceId",
      "value": ""
    },
    {
      "key": "articleId",
      "value": ""
    },
    {
      "key": "categorieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('API ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"nouveau.membre\",\n  \"email\": \"nouveau@exemple.fr\",\n  \"motDePasse\": \"motdepasse\",\n  \"dateNaissance\": \"1999-03-01\",\n  \"estPrive\": false,\n  \"conditionsAcceptees\": true,\n  \"emailTuteur\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inscription"
              ]
            },
            "description": "Crée le compte et connecte l'utilisateur. Un mineur doit indiquer emailTuteur (e-mail d'un compte majeur existant). Erreurs de validation : 422 avec un objet violations { champ: message }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Compte créé (201) ou déjà existant (422)', () => pm.expect(pm.response.code).to.be.oneOf([201, 422]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"motDePasse\": \"{{motDePasse}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/connexion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "connexion"
              ]
            },
            "description": "Ouvre une session (cookie PHPSESSID). 401 si les identifiants sont incorrects, 429 après 5 échecs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Utilisateur renvoyé', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Utilisateur connecté",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/moi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "moi"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
